# === 重要安全提示 ===
# 1. 使用前请重命名本文件为 .env
# 2. 永远不要提交真实密钥到Git！

# Crawl4AI API密钥（登录 https://crawl4ai.com/settings/api-keys 获取）
CRAWL4AI_KEY=your_crawl4ai_key_here

# Jina AI密钥（登录 https://cloud.jina.ai/settings/tokens 生成）
JINA_KEY=jina_your_key_here

# 其他API配置
API_KEY=your_api_key_here

# 数据库配置（示例）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=user123
# 密码留空，建议使用环境变量单独注入
DB_PASSWORD=

# 调试模式（开发时设为True）
DEBUG=False
